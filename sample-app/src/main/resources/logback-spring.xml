<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Include observability-core logging configuration -->
    <include resource="logback-spring-observability.xml"/>

    <!-- Set environment variables with defaults -->
    <springProperty scope="context" name="APP_NAME" source="spring.application.name" defaultValue="sample-app"/>
    <springProperty scope="context" name="ENV" source="spring.profiles.active" defaultValue="local"/>
    <springProperty scope="context" name="LOKI_URL" source="loki.url" defaultValue="http://localhost:3100"/>

    <!-- Local profile - console only -->
    <springProfile name="!docker">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <!-- Docker profile - console + Loki -->
    <springProfile name="docker">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="LOKI"/>
        </root>
    </springProfile>
</configuration>
